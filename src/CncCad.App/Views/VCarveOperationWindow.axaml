<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CncCad.App.ViewModels" x:Class="CncCad.App.Views.VCarveOperationWindow" x:DataType="vm:VCarveOperationEditorViewModel" Width="620" Height="670" WindowStartupLocation="CenterOwner" Background="#181E23" Title="V-Carve Toolpath"><Grid RowDefinitions="Auto,*,Auto"><Border Background="#20282E" Padding="24,18"><StackPanel><TextBlock Text="V-Carve Toolpath" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Variable-depth carving with one V-bit and a maximum-depth limit." Foreground="#9AA9B4"/></StackPanel></Border><ScrollViewer Grid.Row="1"><StackPanel Margin="24,18" Spacing="9"><TextBlock Text="Operation name"/><TextBox Text="{Binding Draft.Name}"/><TextBlock Text="V-bit"/><ComboBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedLibraryTool}" SelectionChanged="ToolPicker_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Maximum depth (mm)"/><NumericUpDown Value="{Binding Draft.MaximumDepthMm}" Minimum="0.001"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Offset step-over (mm)"/><NumericUpDown Value="{Binding Draft.OffsetStepOverMm}" Minimum="0.001"/></StackPanel></Grid><CheckBox Content="Clear broad flat regions with the V-bit at maximum depth" IsChecked="{Binding Draft.ClearFlatRegions}"/><Border Background="#26333B" Padding="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Effective width at maximum depth"/><TextBlock Grid.Column="1" Text="{Binding WidthAtDepth, StringFormat='{}{0:0.###} mm'}" Foreground="#65C9FF"/></Grid></Border><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Feed mm/min"/><NumericUpDown Value="{Binding Draft.FeedRateMmPerMin}" Minimum="1"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Plunge mm/min"/><NumericUpDown Value="{Binding Draft.PlungeRateMmPerMin}" Minimum="1"/></StackPanel></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Spindle RPM"/><NumericUpDown Value="{Binding Draft.SpindleRpm}" Minimum="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Safe Z"/><NumericUpDown Value="{Binding Draft.SafeZMm}" Minimum="0.001"/></StackPanel></Grid><TextBlock Text="{Binding ValidationMessage}" Foreground="#FF9C9C" TextWrapping="Wrap"/><TextBlock Text="Preview and preflight reduce risk but do not guarantee a crash-free physical setup." Foreground="#E8B85C" TextWrapping="Wrap"/></StackPanel></ScrollViewer><Border Grid.Row="2" Background="#20282E" Padding="18,14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save Toolpath" Click="Save_Click"/></StackPanel></Border></Grid></Window>
