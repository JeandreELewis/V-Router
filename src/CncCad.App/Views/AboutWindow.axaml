<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CncCad.App.Views.AboutWindow" Width="500" Height="470" CanResize="False" WindowStartupLocation="CenterOwner" Background="#181E23" Title="About V-Router" Icon="avares://V-Router/Assets/v-router.ico">
  <Grid RowDefinitions="*,Auto"><StackPanel Margin="28" Spacing="9"><Image Source="avares://V-Router/Assets/v-router-logo.png" Width="104" Height="104" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="V-Router logo"/><TextBlock Text="V-Router" FontSize="30" FontWeight="Bold" Foreground="#65C9FF"/><TextBlock Text="Open-source router-focused CAD/CAM" FontSize="17"/><TextBlock x:Name="VersionText" Foreground="#A9BAC4"/><TextBlock x:Name="RuntimeText" Foreground="#A9BAC4"/><TextBlock Text="Project format version 9" Foreground="#A9BAC4"/><Border Classes="guidance" Margin="0,12,0,0"><TextBlock Text="Toolpath preview, font compatibility, and safety preflight assist verification but do not guarantee safe physical machining. Verify every program at the machine." TextWrapping="Wrap"/></Border><TextBlock Text="Licensed under the MIT License. Third-party acknowledgements are recorded in docs/THIRD_PARTY_NOTICES.md." TextWrapping="Wrap" Foreground="#91A1AD"/></StackPanel><Border Grid.Row="1" Background="#20282E" Padding="14"><Button Content="Close" HorizontalAlignment="Right" Click="Close_Click"/></Border></Grid>
</Window>
