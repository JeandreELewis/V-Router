<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CncCad.App.ViewModels" x:Class="CncCad.App.Views.EngraveOperationWindow" x:DataType="vm:EngraveOperationEditorViewModel" Width="620" Height="650" WindowStartupLocation="CenterOwner" Background="#181E23" Title="Engraving Toolpath"><Grid RowDefinitions="Auto,*,Auto"><Border Background="#20282E" Padding="24,18"><StackPanel><TextBlock Text="Engraving Toolpath" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Follow open or closed vectors at a constant depth." Foreground="#9AA9B4"/></StackPanel></Border><ScrollViewer Grid.Row="1"><StackPanel Margin="24,18" Spacing="9"><TextBlock Text="Operation name"/><TextBox Text="{Binding Draft.Name}"/><TextBlock Text="Tool"/><ComboBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedLibraryTool}" SelectionChanged="ToolPicker_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Direction"/><ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Draft.Direction}"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Start depth"/><NumericUpDown Value="{Binding Draft.StartDepthMm}" Minimum="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Final depth"/><NumericUpDown Value="{Binding Draft.CutDepthMm}" Minimum="0.001"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Pass depth"/><NumericUpDown Value="{Binding Draft.PassDepthMm}" Minimum="0.001"/></StackPanel></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Feed mm/min"/><NumericUpDown Value="{Binding Draft.FeedRateMmPerMin}" Minimum="1"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Plunge mm/min"/><NumericUpDown Value="{Binding Draft.PlungeRateMmPerMin}" Minimum="1"/></StackPanel></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Spindle RPM"/><NumericUpDown Value="{Binding Draft.SpindleRpm}" Minimum="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Safe Z"/><NumericUpDown Value="{Binding Draft.SafeZMm}" Minimum="0.001"/></StackPanel></Grid><Border Background="#26333B" Padding="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Draft.GeometryIds.Count, StringFormat='{}{0} vectors'}"/><TextBlock Grid.Column="1" Text="{Binding PassCount, StringFormat='{}{0} passes'}" Foreground="#65C9FF"/></Grid></Border><TextBlock Text="{Binding ValidationMessage}" Foreground="#FF9C9C"/></StackPanel></ScrollViewer><Border Grid.Row="2" Background="#20282E" Padding="18,14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save Toolpath" Click="Save_Click"/></StackPanel></Border></Grid></Window>
