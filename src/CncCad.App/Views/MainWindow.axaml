<?xml version="1.0"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CncCad.App.ViewModels"
        xmlns:views="using:CncCad.App.Views"
        xmlns:help="using:CncCad.App"
        xmlns:cam="using:CncCad.Cam.Operations"
        xmlns:tools="using:CncCad.Cam.Tools"
        xmlns:nest="using:CncCad.Cam.Nesting"
        xmlns:safety="using:CncCad.Cam.Safety"
        xmlns:core="using:CncCad.Core.Documents"
        xmlns:entities="using:CncCad.Core.Entities"
        xmlns:rendering="using:CncCad.Rendering.Canvas"
        x:Class="CncCad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1500" Height="920" MinWidth="1100" MinHeight="700"
        Background="#12171B" Title="V-Router — CNC CAD/CAM" Icon="avares://V-Router/Assets/v-router.ico">
  <Grid RowDefinitions="28,44,*,24">
    <Menu x:Name="ApplicationMenuBar" Grid.Row="0" Background="#171E23">
      <MenuItem Header="_File"><MenuItem Header="New Job" HotKey="Ctrl+N" Click="NewJob_Click"/><MenuItem Header="Open…" HotKey="Ctrl+O" Click="Open_Click"/><MenuItem Header="Open Recent" ItemsSource="{Binding RecentProjects}"><MenuItem.ItemTemplate><DataTemplate><MenuItem Header="{Binding Name}" Tag="{Binding Path}" Click="RecentMenuItem_Click"/></DataTemplate></MenuItem.ItemTemplate></MenuItem><MenuItem Header="Clear Recent Projects" Click="ClearRecent_Click"/><Separator/><MenuItem Header="Import SVG/DXF…" Click="Import_Click" IsEnabled="{Binding HasJob}"/><Separator/><MenuItem Header="Save" HotKey="Ctrl+S" Click="Save_Click" IsEnabled="{Binding HasJob}"/><MenuItem Header="Save As…" HotKey="Ctrl+Shift+S" Click="SaveAs_Click" IsEnabled="{Binding HasJob}"/><MenuItem Header="Edit Job Setup…" Click="EditJob_Click" IsEnabled="{Binding HasJob}"/><Separator/><MenuItem Header="Save Toolpaths…" Click="SaveToolpaths_Click" IsEnabled="{Binding CanSaveToolpaths}" ToolTip.Tip="{Binding ExportAvailabilityMessage}"/><MenuItem Header="Exit" Click="Exit_Click"/></MenuItem>
      <MenuItem Header="_Edit"><MenuItem Header="Undo" HotKey="Ctrl+Z" Click="Undo_Click" IsEnabled="{Binding CanUndo}"/><MenuItem Header="Redo" HotKey="Ctrl+Shift+Z" Click="Redo_Click" IsEnabled="{Binding CanRedo}"/><Separator/><MenuItem Header="Copy" HotKey="Ctrl+C" Click="Copy_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Paste" HotKey="Ctrl+V" Click="Paste_Click" IsEnabled="{Binding HasClipboard}"/><MenuItem Header="Duplicate" HotKey="Ctrl+D" Click="Duplicate_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Delete" Click="Delete_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Select All" HotKey="Ctrl+A" Click="SelectAll_Click" IsEnabled="{Binding HasGeometry}"/><Separator/><MenuItem Header="Settings…" HotKey="Ctrl+," Click="Settings_Click"/></MenuItem>
      <MenuItem Header="_View"><MenuItem Header="Design Focus" Click="DesignFocus_Click"/><MenuItem Header="Toolpaths Focus" Click="ToolpathFocus_Click"/><Separator/><MenuItem Header="2D Design" Click="DesignView_Click"/><MenuItem Header="3D Preview" Click="ToolpathView_Click"/><MenuItem Header="Horizontal Split" Click="HorizontalSplit_Click"/><MenuItem Header="Vertical Split" Click="VerticalSplit_Click"/><Separator/><MenuItem Header="Zoom to Fit" Click="ZoomFit_Click"/><MenuItem Header="Zoom to Selection" Click="ZoomSelection_Click" IsEnabled="{Binding HasSelection}"/><Separator/><MenuItem Header="Show Grid" Click="GridMenu_Click"/><MenuItem Header="Enable Snapping" Click="SnapMenu_Click"/><MenuItem Header="Show Toolpaths" Click="PathsMenu_Click"/><MenuItem Header="Preview appearance" IsEnabled="{Binding HasJob}"><MenuItem Header="Toggle Technical / Material" Click="AppearanceToggle_Click" help:CommandHelp.Key="view.appearance"/><MenuItem Header="Hardwood" Tag="Hardwood" Click="PreviewMaterial_Click"/><MenuItem Header="Softwood" Tag="Softwood" Click="PreviewMaterial_Click"/><MenuItem Header="Plywood" Tag="Plywood" Click="PreviewMaterial_Click"/><MenuItem Header="MDF" Tag="Mdf" Click="PreviewMaterial_Click"/></MenuItem><Separator/><MenuItem Header="Isometric" Tag="Isometric" Click="CameraPresetMenu_Click"/><MenuItem Header="Top" Tag="Top" Click="CameraPresetMenu_Click"/><MenuItem Header="Bottom" Tag="Bottom" Click="CameraPresetMenu_Click"/><MenuItem Header="Front" Tag="Front" Click="CameraPresetMenu_Click"/><MenuItem Header="Back" Tag="Back" Click="CameraPresetMenu_Click"/><MenuItem Header="Left" Tag="Left" Click="CameraPresetMenu_Click"/><MenuItem Header="Right" Tag="Right" Click="CameraPresetMenu_Click"/></MenuItem>
      <MenuItem Header="_Design"><MenuItem Header="Select / Move" Tag="Select" Click="DrawingToolMenu_Click"/><MenuItem Header="Line" Tag="Line" Click="DrawingToolMenu_Click"/><MenuItem Header="Polyline" Tag="Polyline" Click="DrawingToolMenu_Click"/><MenuItem Header="Rectangle" Tag="Rectangle" Click="DrawingToolMenu_Click"/><MenuItem Header="Circle" Tag="Circle" Click="DrawingToolMenu_Click"/><MenuItem Header="Three-Point Arc" Tag="Arc" Click="DrawingToolMenu_Click"/><Separator/><MenuItem Header="Scissors Trim" Click="TrimTool_Click"/><MenuItem Header="Node Edit" Click="NodeEditMenu_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Center on Material" Click="CenterSelection_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Group" Click="Group_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Ungroup" Click="Ungroup_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Analyze Vector Repair" Click="AnalyzeRepair_Click" IsEnabled="{Binding HasGeometry}"/></MenuItem>
      <MenuItem Header="_Toolpaths"><MenuItem Header="Create Profile…" Click="CreateProfile_Click" IsEnabled="{Binding CanCreateProfile}"/><MenuItem Header="Create Pocket…" Click="CreatePocket_Click" IsEnabled="{Binding CanCreateProfile}"/><MenuItem Header="Create Drill…" Click="CreateDrill_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Create Engraving…" Click="CreateEngrave_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Create V-Carve…" Click="CreateVCarve_Click" IsEnabled="{Binding CanCreateVCarve}" ToolTip.Tip="{Binding VCarveGuidance}"/><Separator/><MenuItem Header="Run Preflight" Click="RunPreflight_Click" IsEnabled="{Binding HasOperations}"/><MenuItem Header="Preview Selected" Click="PreviewSelected_Click" IsEnabled="{Binding SelectedOperation}"/><MenuItem Header="Preview All" Click="PreviewGCode_Click" IsEnabled="{Binding HasOperations}"/><MenuItem Header="Save Toolpaths…" Click="SaveToolpaths_Click" IsEnabled="{Binding CanSaveToolpaths}" ToolTip.Tip="{Binding ExportAvailabilityMessage}"/></MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="Keyboard Shortcuts…" Click="Shortcuts_Click"/><MenuItem Header="About V-Router" Click="About_Click"/></MenuItem>
    </Menu>

    <Border Grid.Row="1" Background="#20282E" BorderBrush="#34414A" BorderThickness="0,0,0,1" Padding="8,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Image x:Name="ShellLogo" Source="avares://V-Router/Assets/v-router-logo.png" Width="30" Height="30" Stretch="Uniform" Margin="0,0,2,0" AutomationProperties.Name="V-Router logo"/>
          <TextBlock Text="V-ROUTER" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,8,0" IsVisible="{Binding IsRegularLayout}"/>
          <Button Classes="toolbarCommand" Click="NewJob_Click" help:CommandHelp.Key="file.new"><StackPanel Orientation="Horizontal" Spacing="5"><Path Width="15" Height="15" Stroke="#E3EDF2" StrokeThickness="1.6" Data="M3,1 L11,1 15,5 15,17 3,17 Z M11,1 L11,5 15,5 M9,8 L9,14 M6,11 L12,11"/><TextBlock Text="New" IsVisible="{Binding IsRegularLayout}"/></StackPanel></Button>
          <Button Classes="toolbarCommand" Click="Open_Click" help:CommandHelp.Key="file.open"><StackPanel Orientation="Horizontal" Spacing="5"><Path Width="16" Height="15" Stroke="#E3EDF2" StrokeThickness="1.6" Data="M1,5 L7,5 9,7 17,7 14,16 2,16 Z M2,5 L2,2 8,2 10,5"/><TextBlock Text="Open" IsVisible="{Binding IsRegularLayout}"/></StackPanel></Button>
          <Button Classes="toolbarCommand" Click="Save_Click" help:CommandHelp.Key="file.save" IsEnabled="{Binding HasJob}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Width="15" Height="15" Stroke="#E3EDF2" StrokeThickness="1.6" Data="M2,2 L14,2 17,5 17,17 2,17 Z M5,2 L5,7 13,7 13,2 M5,11 L14,11 14,17 5,17 Z"/><TextBlock Text="Save" IsVisible="{Binding IsRegularLayout}"/></StackPanel></Button>
          <Border Width="1" Background="#46535C" Margin="4,2"/>
          <Button Classes="toolbarCommand" Click="Undo_Click" help:CommandHelp.Key="edit.undo" IsEnabled="{Binding CanUndo}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Width="16" Height="15" Stroke="#E3EDF2" Data="M7,4 L2,8 7,12 M3,8 L11,8 C15,8 17,11 17,15"/><TextBlock Text="Undo" IsVisible="{Binding IsRegularLayout}"/></StackPanel></Button>
          <Button Classes="toolbarCommand" Click="Redo_Click" help:CommandHelp.Key="edit.redo" IsEnabled="{Binding CanRedo}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Width="16" Height="15" Stroke="#E3EDF2" Data="M12,4 L17,8 12,12 M16,8 L8,8 C4,8 2,11 2,15"/><TextBlock Text="Redo" IsVisible="{Binding IsRegularLayout}"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" MaxWidth="320"><TextBlock Text="{Binding JobTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding JobTitle}" HorizontalAlignment="Center"/><TextBlock Text="{Binding MaterialSummary}" FontSize="9" Foreground="#91A1AD" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MaterialSummary}" HorizontalAlignment="Center" IsVisible="{Binding IsRegularLayout}"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><ToggleButton Classes="toolbarMode" Content="Design" IsChecked="{Binding IsDesignMode}" Click="DesignFocus_Click" IsEnabled="{Binding HasJob}"/><ToggleButton Classes="toolbarMode" Content="Toolpaths" IsChecked="{Binding IsToolpathsMode}" Click="ToolpathFocus_Click" IsEnabled="{Binding HasJob}"/><ToggleButton x:Name="HelpModeToggle" Classes="iconCommand" Content="?" FontWeight="Bold" Click="HelpMode_Click" help:CommandHelp.Key="help.mode"/></StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnDefinitions="0,*,0">
      <views:TaskPanelHost Grid.Column="0" IsVisible="{Binding IsDesignMode}">
        <views:TaskPanelHost.HeaderContent><Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><Button Classes="iconCommand" Content="‹" Click="CloseDesignTask_Click" IsVisible="{Binding !IsDesignPalette}" ToolTip.Tip="Back to Design tools"/><TextBlock Grid.Column="1" Text="{Binding DesignTaskTitle}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DesignTaskTitle}"/></Grid></views:TaskPanelHost.HeaderContent>
        <views:TaskPanelHost.Body>
          <Grid>
            <ScrollViewer IsVisible="{Binding IsDesignPalette}"><StackPanel Margin="8" Spacing="4">
              <TextBlock Classes="sectionHeading" Text="CREATE VECTORS"/>
              <ListBox x:Name="DrawingToolPalette" ItemsSource="{Binding CreationTools}" SelectedItem="{Binding ActivePaletteItem}" SelectionChanged="DrawingToolPalette_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="38" ItemHeight="38"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="#252E34"/><Setter Property="BorderBrush" Value="#39464F"/><Setter Property="BorderThickness" Value="1"/></Style><Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#174E69"/><Setter Property="BorderBrush" Value="{DynamicResource CncAccentBrush}"/></Style></ListBox.Styles>
                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ToolPaletteItem"><Path Data="{Binding IconData}" Width="20" Height="20" Stretch="Uniform" Stroke="#E3EDF2" StrokeThickness="1.7" ToolTip.Tip="{Binding Tooltip}" help:CommandHelp.Key="{Binding HelpKey}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button Classes="paletteCommand" Tag="TextShapes" Click="OpenDesignTask_Click" help:CommandHelp.Key="draw.text"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,3 L17,3 M10,3 L10,18 M6,18 L14,18"/></Button>
              <TextBlock Classes="sectionHeading" Text="TRANSFORM"/>
              <WrapPanel><Button Classes="paletteCommand" Tag="Position" Click="OpenDesignTask_Click" IsEnabled="{Binding HasSelection}" help:CommandHelp.Key="edit.position"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M10,1 L10,19 M1,10 L19,10"/></Button><Button Classes="paletteCommand" Tag="Transform" Click="OpenDesignTask_Click" IsEnabled="{Binding HasSelection}" help:CommandHelp.Key="edit.transform"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,7 L3,3 7,3 M13,3 L17,3 17,7 M17,13 L17,17 13,17 M7,17 L3,17 3,13"/></Button><Button Classes="paletteCommand" Click="Copy_Click" IsEnabled="{Binding HasSelection}" help:CommandHelp.Key="edit.copy"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M7,7 L18,7 18,18 7,18 Z M3,14 L3,3 14,3"/></Button><Button Classes="paletteCommand" Click="Paste_Click" IsEnabled="{Binding HasClipboard}" help:CommandHelp.Key="edit.paste"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M6,4 L15,4 17,7 17,18 4,18 4,7 Z"/></Button><Button Classes="paletteCommand" Click="Duplicate_Click" IsEnabled="{Binding HasSelection}" help:CommandHelp.Key="edit.duplicate"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M6,6 L16,6 16,16 6,16 Z M3,13 L3,3 13,3"/></Button><Button Classes="paletteCommand" Click="Delete_Click" IsEnabled="{Binding HasSelection}" help:CommandHelp.Key="edit.delete"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M4,5 L16,5 M6,5 L7,18 13,18 14,5"/></Button></WrapPanel>
              <TextBlock Classes="sectionHeading" Text="EDIT"/>
              <WrapPanel><Button Classes="paletteCommand" Tag="Edit" Click="OpenDesignTask_Click" IsEnabled="{Binding HasSelection}" help:CommandHelp.Key="edit.nodes"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,16 L3,18 5,18 17,6 14,3 Z"/></Button><Button Classes="paletteCommand" Click="TrimTool_Click" IsEnabled="{Binding HasGeometry}" help:CommandHelp.Key="edit.trim"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,5 A3,3 0 1 0 9,5 A3,3 0 1 0 3,5 M3,15 A3,3 0 1 0 9,15 A3,3 0 1 0 3,15 M8,7 L19,17 M8,13 L19,3"/></Button><Button Classes="paletteCommand" Tag="Repair" Click="OpenDesignTask_Click" help:CommandHelp.Key="edit.repair"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,16 L8,11 M12,7 L17,2 M13,2 L17,2 17,6 M5,3 C9,1 13,4 12,8 C11,12 6,13 3,10"/></Button><Button Classes="paletteCommand" Tag="OffsetLayout" Click="OpenDesignTask_Click" help:CommandHelp.Key="edit.offset"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,4 L13,4 13,14 3,14 Z M7,8 L17,8 17,18 7,18 Z"/></Button></WrapPanel>
              <TextBlock Classes="sectionHeading" Text="CONTEXT"/>
              <WrapPanel><Button Classes="paletteCommand" Tag="Layers" Click="OpenDesignTask_Click" help:CommandHelp.Key="context.layers"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M2,6 L10,2 18,6 10,10 Z M2,10 L10,14 18,10 M2,14 L10,18 18,14"/></Button><Button Classes="paletteCommand" Tag="Appearance" Click="OpenDesignTask_Click" help:CommandHelp.Key="context.appearance"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M10,2 C5,2 2,6 2,10 C2,15 6,18 10,18 C13,18 12,14 14,13 C18,12 19,7 16,4 C14,2 12,2 10,2 Z"/></Button><Button Classes="paletteCommand" Tag="Snapping" Click="OpenDesignTask_Click" help:CommandHelp.Key="context.snapping"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,2 L3,12 C3,19 17,19 17,12 L17,2 M3,7 L8,7 M12,7 L17,7"/></Button><Button Classes="paletteCommand" Tag="Nesting" Click="OpenDesignTask_Click" help:CommandHelp.Key="context.nesting"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M2,2 L18,2 18,18 2,18 Z M4,4 L10,4 10,9 4,9 Z M12,4 L16,4 16,12 12,12 Z"/></Button><Button Classes="paletteCommand" Tag="Job" Click="OpenDesignTask_Click" help:CommandHelp.Key="context.job"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,5 L17,5 17,17 3,17 Z M7,5 L7,2 13,2 13,5"/></Button><Button Classes="paletteCommand" Click="Import_Click" help:CommandHelp.Key="context.import"><Path Width="20" Height="20" Stroke="#E3EDF2" Data="M3,2 L13,2 17,6 17,18 3,18 Z M10,8 L10,15 M7,12 L10,15 13,12"/></Button></WrapPanel>
            </StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignConstructionTask}"><StackPanel Margin="8" Spacing="6"><TextBlock Text="Use the canvas, or enter exact dimensions." Foreground="#91A1AD" FontSize="10" TextWrapping="Wrap"/><Border Classes="panelCard" IsVisible="{Binding ShowExactLine}"><StackPanel Spacing="5"><TextBlock Text="EXACT LINE" FontWeight="Bold"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point1X}" PlaceholderText="Start X"/><NumericUpDown Grid.Column="1" Value="{Binding Point1Y}" PlaceholderText="Start Y"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point2X}" PlaceholderText="End X"/><NumericUpDown Grid.Column="1" Value="{Binding Point2Y}" PlaceholderText="End Y"/></Grid><CheckBox Content="Use length and angle" IsChecked="{Binding ExactUsesLengthAngle}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding ExactLength}" PlaceholderText="Length"/><NumericUpDown Grid.Column="1" Value="{Binding ExactAngle}" PlaceholderText="Angle"/></Grid><Button Classes="primary" Content="Create Line" Click="CreateExact_Click"/></StackPanel></Border><Border Classes="panelCard" IsVisible="{Binding ShowExactPolyline}"><StackPanel Spacing="5"><TextBlock Text="EXACT POLYLINE" FontWeight="Bold"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point2X}" PlaceholderText="Next X"/><NumericUpDown Grid.Column="1" Value="{Binding Point2Y}" PlaceholderText="Next Y"/></Grid><Button Content="Add Node" Click="AddNumericNode_Click"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="5"><Button Content="Finish" Click="FinishNumericPolyline_Click"/><Button Grid.Column="1" Content="Close" Click="CloseNumericPolyline_Click"/><Button Grid.Column="2" Content="Cancel" Click="CancelNumericPolyline_Click"/></Grid></StackPanel></Border><Border Classes="panelCard" IsVisible="{Binding ShowExactRectangle}"><StackPanel Spacing="5"><TextBlock Text="EXACT RECTANGLE" FontWeight="Bold"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point1X}" PlaceholderText="X"/><NumericUpDown Grid.Column="1" Value="{Binding Point1Y}" PlaceholderText="Y"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding ExactWidth}" PlaceholderText="Width"/><NumericUpDown Grid.Column="1" Value="{Binding ExactHeight}" PlaceholderText="Height"/></Grid><Button Classes="primary" Content="Create Rectangle" Click="CreateExact_Click"/></StackPanel></Border><Border Classes="panelCard" IsVisible="{Binding ShowExactCircle}"><StackPanel Spacing="5"><TextBlock Text="EXACT CIRCLE" FontWeight="Bold"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point1X}" PlaceholderText="Centre X"/><NumericUpDown Grid.Column="1" Value="{Binding Point1Y}" PlaceholderText="Centre Y"/></Grid><NumericUpDown Value="{Binding ExactRadius}" PlaceholderText="Radius / diameter"/><CheckBox Content="Value is diameter" IsChecked="{Binding CircleUsesDiameter}"/><Button Classes="primary" Content="Create Circle" Click="CreateExact_Click"/></StackPanel></Border><Border Classes="panelCard" IsVisible="{Binding ShowExactArc}"><StackPanel Spacing="5"><TextBlock Text="EXACT ARC" FontWeight="Bold"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point1X}" PlaceholderText="Start X"/><NumericUpDown Grid.Column="1" Value="{Binding Point1Y}" PlaceholderText="Start Y"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point2X}" PlaceholderText="Through X"/><NumericUpDown Grid.Column="1" Value="{Binding Point2Y}" PlaceholderText="Through Y"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point3X}" PlaceholderText="End X"/><NumericUpDown Grid.Column="1" Value="{Binding Point3Y}" PlaceholderText="End Y"/></Grid><Button Classes="primary" Content="Create Arc" Click="CreateExact_Click"/></StackPanel></Border></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignPositionTask}"><StackPanel Margin="8" Spacing="6"><TextBlock Text="{Binding SelectionStatus}" Foreground="#E5C56B" TextTrimming="CharacterEllipsis"/><Grid ColumnDefinitions="*,*" ColumnSpacing="6"><NumericUpDown Value="{Binding SelectionX}" PlaceholderText="X · left"/><NumericUpDown Grid.Column="1" Value="{Binding SelectionY}" PlaceholderText="Y · bottom"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="6"><Button Content="Apply" Click="ApplyPosition_Click"/><Button Grid.Column="1" Content="Center" Click="CenterSelection_Click"/></Grid></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignTransformTask}"><StackPanel Margin="8" Spacing="6"><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding PivotX}" PlaceholderText="Pivot X"/><NumericUpDown Grid.Column="1" Value="{Binding PivotY}" PlaceholderText="Pivot Y"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="5"><NumericUpDown Value="{Binding TransformAngle}" PlaceholderText="Angle"/><Button Grid.Column="1" Content="Rotate" Click="Rotate_Click"/></Grid><Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4"><NumericUpDown Value="{Binding ScaleX}" PlaceholderText="Scale X"/><NumericUpDown Grid.Column="1" Value="{Binding ScaleY}" PlaceholderText="Scale Y"/><Button Grid.Column="2" Content="Apply" Click="Scale_Click"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Mirror H" Click="MirrorH_Click"/><Button Grid.Column="1" Content="Mirror V" Click="MirrorV_Click"/></Grid><TextBlock Classes="sectionHeading" Text="ALIGN"/><UniformGrid Columns="3"><Button Content="Left" Tag="Left" Click="Align_Click"/><Button Content="Centre X" Tag="HCenter" Click="Align_Click"/><Button Content="Right" Tag="Right" Click="Align_Click"/><Button Content="Bottom" Tag="Bottom" Click="Align_Click"/><Button Content="Centre Y" Tag="VCenter" Click="Align_Click"/><Button Content="Top" Tag="Top" Click="Align_Click"/></UniformGrid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Distribute H" Click="DistributeH_Click"/><Button Grid.Column="1" Content="Distribute V" Click="DistributeV_Click"/></Grid></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignEditTask}"><StackPanel Margin="8" Spacing="6"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button Content="Join" Click="Join_Click"/><Button Grid.Column="1" Content="Open" Click="OpenPath_Click"/><Button Grid.Column="2" Content="Close" Click="ClosePath_Click"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding ChamferDistance}" PlaceholderText="Chamfer" IsEnabled="{Binding CanUseChamferFillet}"/><NumericUpDown Grid.Column="1" Value="{Binding FilletRadius}" PlaceholderText="Fillet" IsEnabled="{Binding CanUseChamferFillet}"/></Grid><NumericUpDown Value="{Binding CornerIndex}" Minimum="0" PlaceholderText="Node index" IsEnabled="{Binding CanUseChamferFillet}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Chamfer" Click="Chamfer_Click" IsEnabled="{Binding CanUseChamferFillet}" ToolTip.Tip="{Binding CornerEditGuidance}"/><Button Grid.Column="1" Content="Fillet" Click="Fillet_Click" IsEnabled="{Binding CanUseChamferFillet}" ToolTip.Tip="{Binding CornerEditGuidance}"/></Grid><TextBlock Text="{Binding CornerEditGuidance}" Foreground="#91A1AD" FontSize="9" TextWrapping="Wrap"/><Button Content="Trim on Canvas" Click="TrimTool_Click"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Group" Click="Group_Click"/><Button Grid.Column="1" Content="Ungroup" Click="Ungroup_Click"/></Grid><TextBlock Classes="sectionHeading" Text="NODE EDIT"/><ToggleButton x:Name="NodeEditToggle" Content="Edit Nodes" Click="NodeEdit_Click"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding NodeX}" PlaceholderText="Node X" IsEnabled="{Binding CanApplyNodePosition}"/><NumericUpDown Grid.Column="1" Value="{Binding NodeY}" PlaceholderText="Node Y" IsEnabled="{Binding CanApplyNodePosition}"/></Grid><Button Content="Apply Node Position" Click="ApplyNode_Click" IsEnabled="{Binding CanApplyNodePosition}"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button Content="Insert" Click="InsertNode_Click" IsEnabled="{Binding CanInsertNode}"/><Button Grid.Column="1" Content="Delete" Click="DeleteNode_Click" IsEnabled="{Binding CanDeleteNode}"/><Button Grid.Column="2" Content="Start" Click="MakeStartNode_Click" IsEnabled="{Binding CanMakeStartNode}"/></Grid></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignOffsetTask}"><StackPanel Margin="8" Spacing="6"><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding OffsetDistance}" PlaceholderText="Signed offset"/><ComboBox Grid.Column="1" ItemsSource="{Binding OffsetJoins}" SelectedItem="{Binding OffsetJoin}"/></Grid><Button Classes="primary" Content="Create Offset" Click="Offset_Click" IsEnabled="{Binding CanOffsetSelection}" ToolTip.Tip="Positive offsets open paths to their left; negative offsets to their right."/><TextBlock Text="Open paths use signed left/right offsets with deterministic miter, bevel or round joins. Closed contours offset inward or outward." Foreground="#91A1AD" FontSize="9" TextWrapping="Wrap"/><Button Content="Center on Material" Click="CenterSelection_Click"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Distribute H" Click="DistributeH_Click"/><Button Grid.Column="1" Content="Distribute V" Click="DistributeV_Click"/></Grid></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignTextTask}"><StackPanel Margin="8" Spacing="6"><TextBlock Classes="sectionHeading" Text="SHAPE"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding Point1X}" PlaceholderText="X"/><NumericUpDown Grid.Column="1" Value="{Binding Point1Y}" PlaceholderText="Y"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding ShapeWidth}" PlaceholderText="Width"/><NumericUpDown Grid.Column="1" Value="{Binding ShapeHeight}" PlaceholderText="Height"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Slot" Click="CreateSlot_Click"/><Button Grid.Column="1" Content="Rounded Rect" Click="CreateRounded_Click"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding ShapeSides}" PlaceholderText="Sides"/><NumericUpDown Grid.Column="1" Value="{Binding ShapeOuterRadius}" PlaceholderText="Outer radius"/></Grid><NumericUpDown Value="{Binding ShapeInnerRadius}" PlaceholderText="Inner radius"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Polygon" Click="CreatePolygon_Click"/><Button Grid.Column="1" Content="Star" Click="CreateStar_Click"/></Grid><TextBlock Classes="sectionHeading" Text="LETTERING"/><TextBox Text="{Binding TextValue}" PlaceholderText="Enter text"/><Grid ColumnDefinitions="*,110" ColumnSpacing="5"><TextBox Text="{Binding FontSearch}" PlaceholderText="Search fonts"/><ComboBox Grid.Column="1" ItemsSource="{Binding FontKindFilters}" SelectedItem="{Binding FontKindFilter}"/></Grid><ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}" PlaceholderText="Font"><ComboBox.ItemTemplate><DataTemplate x:DataType="entities:FontCatalogEntry"><TextBlock Text="{Binding Descriptor.Family}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><TextBox Text="{Binding TextFontStyle}" PlaceholderText="Font style"/><ComboBox Grid.Column="1" ItemsSource="{Binding TextAlignments}" SelectedItem="{Binding TextAlignment}" PlaceholderText="Alignment"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding TextSize}" PlaceholderText="Size"/><NumericUpDown Grid.Column="1" Value="{Binding TextLetterSpacing}" PlaceholderText="Letter space"/><NumericUpDown Grid.Column="2" Value="{Binding TextLineSpacing}" PlaceholderText="Line space"/></Grid><TextBlock Classes="sectionHeading" Text="TEXT ON PATH"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding TextPathStart}" PlaceholderText="Start 0–1"/><NumericUpDown Grid.Column="1" Value="{Binding TextPathOffset}" PlaceholderText="Baseline"/></Grid><WrapPanel><CheckBox Content="Reverse" IsChecked="{Binding TextPathReverse}"/><CheckBox Content="Flip side" IsChecked="{Binding TextPathFlip}"/><CheckBox Content="Fit spacing" IsChecked="{Binding TextPathFit}"/><CheckBox Content="Keep upright" IsChecked="{Binding TextKeepUpright}"/></WrapPanel><Button Classes="primary" Content="Create Text" Click="CreateText_Click"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Update" Click="UpdateText_Click"/><Button Grid.Column="1" Content="To Vectors" Click="ConvertText_Click"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button Content="Center" Click="CenterTextPath_Click"/><Button Grid.Column="1" Content="Reverse" Click="ReverseTextPath_Click"/><Button Grid.Column="2" Content="Flip" Click="FlipTextPath_Click"/></Grid><Button Content="Reset Spacing" Click="ResetTextSpacing_Click"/></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignAppearanceTask}"><StackPanel Margin="8" Spacing="6"><WrapPanel><Button Width="30" Height="26" Background="#65C9FF" Tag="#65C9FF" Click="PaletteColor_Click"/><Button Width="30" Height="26" Background="#FFD84D" Tag="#FFD84D" Click="PaletteColor_Click"/><Button Width="30" Height="26" Background="#FF6B6B" Tag="#FF6B6B" Click="PaletteColor_Click"/><Button Width="30" Height="26" Background="#70E08D" Tag="#70E08D" Click="PaletteColor_Click"/><Button Width="30" Height="26" Background="#B98CFF" Tag="#B98CFF" Click="PaletteColor_Click"/><Button Width="30" Height="26" Background="#FFFFFF" Tag="#FFFFFF" Click="PaletteColor_Click"/></WrapPanel><TextBox Text="{Binding VectorColor}" PlaceholderText="#RRGGBB"/><Button Classes="primary" Content="Apply to Selection" Click="ApplyColor_Click"/><CheckBox Content="Use for new vectors" IsChecked="{Binding UseDrawingColor}"/><Button Content="Pick Selected Colour" Click="PickColor_Click"/><Button Content="Use Layer Colour" Click="LayerColor_Click"/></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignRepairTask}"><StackPanel Margin="8" Spacing="6"><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding RepairTolerance}" PlaceholderText="Tolerance" ToolTip.Tip="Endpoint and equality tolerance in world millimetres"/><NumericUpDown Grid.Column="1" Value="{Binding MinimumSegment}" PlaceholderText="Min segment" ToolTip.Tip="Remove shorter segments using world-millimetre length"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Analyze" Click="AnalyzeRepair_Click"/><Button Grid.Column="1" Classes="primary" Content="Apply Safe Repairs" Click="ApplyRepair_Click" IsEnabled="{Binding CanApplyRepair}" ToolTip.Tip="Enabled only when the preview contains unambiguous repairs"/></Grid><TextBlock Text="Closed crossings are rebuilt as bounded simple contours and single-segment overlaps are merged. Branched open networks remain diagnostics until you choose their topology." Foreground="#E8B85C" TextWrapping="Wrap" FontSize="9"/><ListBox ItemsSource="{Binding RepairIssues}" MinHeight="100"/></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignSnappingTask}"><StackPanel Margin="8" Spacing="8"><CheckBox Content="Snap to grid" IsChecked="{Binding SnapSettings.Grid}"/><CheckBox Content="Snap to endpoints" IsChecked="{Binding SnapSettings.Endpoint}"/><CheckBox Content="Snap to midpoints" IsChecked="{Binding SnapSettings.Midpoint}"/><CheckBox Content="Snap to centres" IsChecked="{Binding SnapSettings.Center}"/><TextBlock Classes="fieldLabel" Text="Grid spacing (mm)"/><NumericUpDown Value="{Binding SnapSettings.GridSpacingMm}" Minimum="0.1" Maximum="1000"/><TextBlock Text="The canvas uses these settings immediately." FontSize="9" Foreground="#91A1AD" TextWrapping="Wrap"/></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignLayersTask}"><StackPanel Margin="8" Spacing="6"><ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" MinHeight="150"><ListBox.ItemTemplate><DataTemplate x:DataType="core:CadLayer"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Text="{Binding LayerNameDraft}" LostFocus="LayerProperties_LostFocus" PlaceholderText="Layer name"/><TextBox Text="{Binding LayerColorDraft}" LostFocus="LayerProperties_LostFocus" PlaceholderText="#RRGGBB"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button Content="New" Click="AddLayer_Click"/><Button Grid.Column="1" Content="Activate" Click="ActivateLayer_Click"/><Button Grid.Column="2" Content="Delete" Click="DeleteLayer_Click"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><Button Content="Move Up" Click="MoveLayerUp_Click"/><Button Grid.Column="1" Content="Move Down" Click="MoveLayerDown_Click"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><Button Content="Show / Hide" Click="ToggleLayerVisibility_Click"/><Button Grid.Column="1" Content="Lock / Unlock" Click="ToggleLayerLock_Click"/></Grid><Button Content="Select Layer Contents" Click="SelectLayer_Click"/><Button Content="Move Selection Here" Click="MoveToLayer_Click"/></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignNestingTask}"><StackPanel Margin="8" Spacing="6"><TextBlock Text="{Binding NestingSummary}" FontSize="10" Foreground="#91A1AD" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding NestQuantity}" PlaceholderText="Quantity"/><CheckBox Grid.Column="1" Content="Allow 90°" IsChecked="{Binding NestAllowQuarterTurn}"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><ComboBox ItemsSource="{Binding NestGrainDirections}" SelectedItem="{Binding NestGrain}" PlaceholderText="Part grain"/><ComboBox Grid.Column="1" ItemsSource="{Binding NestGrainDirections}" SelectedItem="{Binding NestSheetGrain}" PlaceholderText="Sheet grain"/></Grid><Button Content="Add Selected Parts" Click="AddNestParts_Click"/><ListBox ItemsSource="{Binding NestParts}" SelectedItem="{Binding SelectedNestPart}" MinHeight="100"><ListBox.ItemTemplate><DataTemplate x:DataType="nest:NestPartDefinition"><TextBlock Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Remove Part" Click="RemoveNestPart_Click"/><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding NestSpacing}" PlaceholderText="Spacing"/><NumericUpDown Grid.Column="1" Value="{Binding NestEdgeMargin}" PlaceholderText="Edge margin"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Optimize" Click="OptimizeNest_Click"/><Button Grid.Column="1" Classes="primary" Content="Accept" Click="AcceptNest_Click" IsEnabled="{Binding CanAcceptNest}" ToolTip.Tip="All requested parts must be placed before accepting."/></Grid></StackPanel></ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDesignJobTask}"><StackPanel Margin="8" Spacing="6"><TextBlock Text="{Binding JobTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding MaterialSummary}" Foreground="#91A1AD" TextWrapping="Wrap"/><TextBlock Text="{Binding OriginSummary}" Foreground="#75CBEF" FontSize="10" TextWrapping="Wrap"/><Button Classes="primary" Content="Edit Job Setup…" Click="EditJob_Click"/></StackPanel></ScrollViewer>
          </Grid>
        </views:TaskPanelHost.Body>
        <views:TaskPanelHost.Footer><TextBlock Text="{Binding DesignGuidance}" FontSize="9" Foreground="#AEBCC5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DesignGuidance}"/></views:TaskPanelHost.Footer>
      </views:TaskPanelHost>

      <Grid x:Name="CenterWorkspaceGrid" Grid.Column="1" RowDefinitions="34,*,0" Background="#11171B">
        <Border Background="#1C2429" BorderBrush="#34414A" BorderThickness="0,0,0,1" Padding="4,3"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
          <StackPanel Orientation="Horizontal" Spacing="3"><ToggleButton x:Name="DesignViewButton" Classes="viewTab" Content="2D" IsChecked="True" Click="DesignView_Click" ToolTip.Tip="2D Design"/><ToggleButton x:Name="PreviewViewButton" Classes="viewTab" Content="3D" Click="ToolpathView_Click" ToolTip.Tip="3D Preview"/><ToggleButton x:Name="HorizontalSplitButton" Classes="iconCommand" Click="HorizontalSplit_Click" ToolTip.Tip="Horizontal Split"><Path Width="16" Height="16" Stroke="#E3EDF2" Data="M2,2 L18,2 18,18 2,18 Z M2,10 L18,10"/></ToggleButton><ToggleButton x:Name="VerticalSplitButton" Classes="iconCommand" Click="VerticalSplit_Click" ToolTip.Tip="Vertical Split"><Path Width="16" Height="16" Stroke="#E3EDF2" Data="M2,2 L18,2 18,18 2,18 Z M10,2 L10,18"/></ToggleButton></StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4"><Button Classes="iconCommand" Click="SourceDesign_Click" ToolTip.Tip="Source design"><Path Width="16" Height="16" Stroke="#E3EDF2" Data="M3,3 L17,3 17,17 3,17 Z M6,6 L14,6 14,14 6,14 Z"/></Button><ComboBox Width="128" ItemsSource="{Binding MaterialSheets}" SelectedItem="{Binding SelectedMaterialSheet}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Source Design" SelectionChanged="MaterialSheet_SelectionChanged"/><ComboBox Width="104" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" DisplayMemberBinding="{Binding Name}" IsVisible="{Binding IsRegularLayout}" ToolTip.Tip="Layer"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3"><Button Classes="iconCommand primary" Click="SelectTool_Click" help:CommandHelp.Key="draw.select" IsVisible="{Binding !IsToolpathPreview}"><Path Width="16" Height="16" Fill="#FFFFFF" Data="M2,1 L15,11 9,12 6,18 Z"/></Button><Button Classes="iconCommand" Click="ZoomFit_Click" help:CommandHelp.Key="view.fit"><Path Width="16" Height="16" Stroke="#E3EDF2" Data="M2,7 L2,2 7,2 M13,2 L18,2 18,7 M18,13 L18,18 13,18 M7,18 L2,18 2,13"/></Button><ToggleButton x:Name="GridToggle" Classes="iconCommand" IsChecked="True" Click="GridToggle_Click" help:CommandHelp.Key="view.grid"><Path Width="16" Height="16" Stroke="#E3EDF2" Data="M2,2 L18,2 M2,7 L18,7 M2,12 L18,12 M2,17 L18,17 M2,2 L2,18 M7,2 L7,18 M12,2 L12,18 M17,2 L17,18"/></ToggleButton><ToggleButton x:Name="SnapToggle" Classes="iconCommand" IsChecked="True" Click="SnapToggle_Click" help:CommandHelp.Key="view.snap"><Path Width="16" Height="16" Stroke="#E3EDF2" Data="M3,2 L3,12 C3,19 17,19 17,12 L17,2 M3,7 L8,7 M12,7 L17,7"/></ToggleButton><ToggleButton x:Name="PathsToggle" Classes="iconCommand" IsChecked="True" Click="PathsToggle_Click" IsVisible="False"/><ToggleButton x:Name="CutterToggle" Classes="iconCommand" IsChecked="True" Click="CutterToggle_Click" IsVisible="False"/><Button Classes="iconCommand" IsVisible="{Binding ShowRegularPreviewAppearance}" Click="AppearanceToggle_Click" help:CommandHelp.Key="view.appearance" ToolTip.Tip="{Binding PreviewAppearanceSummary}"><Path Width="18" Height="18" Stroke="#E9C58C" StrokeThickness="1.5" Data="M2,5 C6,2 12,8 18,4 M2,10 C7,7 12,13 18,9 M2,15 C7,12 13,18 18,14"/></Button><Button Classes="iconCommand" IsVisible="{Binding ShowRegularPreviewAppearance}" Content="▾" FontSize="9" Click="AppearanceMenu_Click" ToolTip.Tip="Choose preview material, grain and tint"><Button.ContextMenu><ContextMenu><MenuItem Header="Material preset"><MenuItem Header="Auto from job material" Tag="Auto" Click="PreviewMaterial_Click"/><MenuItem Header="Hardwood" Tag="Hardwood" Click="PreviewMaterial_Click"/><MenuItem Header="Softwood" Tag="Softwood" Click="PreviewMaterial_Click"/><MenuItem Header="Plywood" Tag="Plywood" Click="PreviewMaterial_Click"/><MenuItem Header="MDF" Tag="Mdf" Click="PreviewMaterial_Click"/></MenuItem><MenuItem Header="Grain direction"><MenuItem Header="Along stock X" Tag="AlongStockX" Click="PreviewGrain_Click"/><MenuItem Header="Along stock Y" Tag="AlongStockY" Click="PreviewGrain_Click"/></MenuItem><MenuItem Header="Tint"><MenuItem Header="Natural" Tag="" Click="PreviewTint_Click"/><MenuItem Header="Light oak" Tag="#E4C59B" Click="PreviewTint_Click"/><MenuItem Header="Warm honey" Tag="#C88D4D" Click="PreviewTint_Click"/><MenuItem Header="Dark walnut" Tag="#70452E" Click="PreviewTint_Click"/></MenuItem><Separator/><MenuItem Header="Reset appearance" Click="PreviewAppearanceReset_Click"/></ContextMenu></Button.ContextMenu></Button><Button Classes="iconCommand" Content="⋯" Click="ViewportOverflow_Click" ToolTip.Tip="More viewport commands"><Button.ContextMenu><ContextMenu><MenuItem Header="Fit Selection" Click="ZoomSelection_Click" IsEnabled="{Binding HasSelection}"/><MenuItem Header="Show Grid" Click="GridMenu_Click"/><MenuItem Header="Enable Snapping" Click="SnapMenu_Click"/><MenuItem Header="Show Toolpaths" Click="PathsMenu_Click"/><MenuItem Header="Show Cutter" Click="CutterMenu_Click"/><MenuItem Header="Preview appearance" IsVisible="{Binding IsToolpathPreview}"><MenuItem Header="Toggle Technical / Material" Click="AppearanceToggle_Click" help:CommandHelp.Key="view.appearance"/><MenuItem Header="Auto from job material" Tag="Auto" Click="PreviewMaterial_Click"/><MenuItem Header="Hardwood" Tag="Hardwood" Click="PreviewMaterial_Click"/><MenuItem Header="Softwood" Tag="Softwood" Click="PreviewMaterial_Click"/><MenuItem Header="Plywood" Tag="Plywood" Click="PreviewMaterial_Click"/><MenuItem Header="MDF" Tag="Mdf" Click="PreviewMaterial_Click"/><Separator/><MenuItem Header="Grain along stock X" Tag="AlongStockX" Click="PreviewGrain_Click"/><MenuItem Header="Grain along stock Y" Tag="AlongStockY" Click="PreviewGrain_Click"/><Separator/><MenuItem Header="Natural tint" Tag="" Click="PreviewTint_Click"/><MenuItem Header="Light oak tint" Tag="#E4C59B" Click="PreviewTint_Click"/><MenuItem Header="Warm honey tint" Tag="#C88D4D" Click="PreviewTint_Click"/><MenuItem Header="Dark walnut tint" Tag="#70452E" Click="PreviewTint_Click"/><MenuItem Header="Reset appearance" Click="PreviewAppearanceReset_Click"/></MenuItem></ContextMenu></Button.ContextMenu></Button></StackPanel>
        </Grid></Border>
        <Grid x:Name="ViewportGrid" Grid.Row="1" RowDefinitions="*" ColumnDefinitions="*">
          <rendering:CadCanvas x:Name="Canvas" IsEnabled="{Binding HasJob}"/><rendering:CadCanvas x:Name="PreviewCanvas" IsEnabled="{Binding HasJob}" IsVisible="False"/>
          <Border x:Name="ViewCube" IsVisible="{Binding HasJob}" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="6" Background="#D91A2227" BorderBrush="#40515C" BorderThickness="1"><Grid>
            <Button Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Content="TOP" FontSize="9" FontWeight="SemiBold" Tag="Top" Click="CameraPreset_Click" ToolTip.Tip="Top view; click for 3D" IsVisible="{Binding !IsToolpathPreview}"/>
            <Canvas Width="62" Height="62" IsVisible="{Binding IsToolpathPreview}"><Path Classes="viewCubeFace" Tag="Top" Data="M31,4 L56,16 L31,28 L6,16 Z" PointerPressed="CameraCubeFace_PointerPressed" ToolTip.Tip="Top view"/><Path Classes="viewCubeFace" Tag="Front" Data="M6,16 L31,28 L31,54 L6,42 Z" PointerPressed="CameraCubeFace_PointerPressed" ToolTip.Tip="Front view"/><Path Classes="viewCubeFace" Tag="Right" Data="M31,28 L56,16 L56,42 L31,54 Z" PointerPressed="CameraCubeFace_PointerPressed" ToolTip.Tip="Right view"/><TextBlock Canvas.Left="23" Canvas.Top="10" Text="T" FontSize="7" IsHitTestVisible="False"/><TextBlock Canvas.Left="12" Canvas.Top="31" Text="F" FontSize="7" IsHitTestVisible="False"/><TextBlock Canvas.Left="44" Canvas.Top="31" Text="R" FontSize="7" IsHitTestVisible="False"/><Button Canvas.Left="44" Canvas.Top="44" Width="17" Height="17" Padding="0" Content="⋯" Click="CubeMore_Click" ToolTip.Tip="More camera views"><Button.ContextMenu><ContextMenu><MenuItem Header="Isometric" Tag="Isometric" Click="CameraPresetMenu_Click"/><MenuItem Header="Left" Tag="Left" Click="CameraPresetMenu_Click"/><MenuItem Header="Back" Tag="Back" Click="CameraPresetMenu_Click"/><MenuItem Header="Bottom" Tag="Bottom" Click="CameraPresetMenu_Click"/></ContextMenu></Button.ContextMenu></Button></Canvas>
          </Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#20292F" BorderBrush="#34414A" BorderThickness="0,1,0,0" Padding="7,5" IsVisible="{Binding ShowPlaybackControls}"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"><StackPanel Orientation="Horizontal" Spacing="3"><Button x:Name="PlayPauseButton" Classes="compact" Content="{Binding PlaybackAction}" Click="PlayPause_Click"/><Button Classes="compact" Content="Stop" Click="PlaybackStop_Click"/><Button Classes="compact" Content="Restart" Click="PlaybackRestart_Click"/></StackPanel><Slider x:Name="PlaybackSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PlaybackProgress}" ValueChanged="PlaybackSlider_ValueChanged"/><ComboBox Grid.Column="2" Width="72" ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding PlaybackSpeed}" SelectionChanged="PlaybackSpeed_SelectionChanged"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PlaybackPosition}" FontSize="9" Foreground="#9FB0BA"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PlaybackTime}" FontSize="9" FontFamily="Menlo,Consolas"/></Grid></Border>
      </Grid>

      <views:TaskPanelHost Grid.Column="2" IsVisible="{Binding IsToolpathsMode}">
        <views:TaskPanelHost.HeaderContent><Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><Button Classes="iconCommand" Content="‹" Click="CloseToolpathTask_Click" IsVisible="{Binding !IsToolpathPalette}" ToolTip.Tip="Back to Toolpaths"/><TextBlock Grid.Column="1" Text="{Binding ToolpathTaskTitle}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ToolpathTaskTitle}"/></Grid></views:TaskPanelHost.HeaderContent>
        <views:TaskPanelHost.Body><Grid>
          <Grid IsVisible="{Binding IsToolpathPalette}" RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="4"><StackPanel><TextBlock Text="{Binding MaterialSummary}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MaterialSummary}"/><TextBlock Text="{Binding SelectedMachine.Name}" FontSize="9" Foreground="#91A1AD" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"><Button Classes="iconCommand" Tag="ToolLibrary" Click="OpenToolpathTask_Click" Content="T" ToolTip.Tip="Tool and material library"/><Button Classes="iconCommand" Tag="MachineFixtures" Click="OpenToolpathTask_Click" Content="M" ToolTip.Tip="Machine and fixtures"/></StackPanel></Grid><UniformGrid Grid.Row="1" Columns="6" Margin="0,7"><Button Classes="paletteCommand" Click="CreateSurface_Click" IsEnabled="{Binding HasJob}" Content="S" ToolTip.Tip="Surface stock"/><Button Classes="paletteCommand" Click="CreateProfile_Click" IsEnabled="{Binding CanCreateProfile}" Content="P" help:CommandHelp.Key="toolpath.profile"/><Button Classes="paletteCommand" Click="CreatePocket_Click" IsEnabled="{Binding CanCreateProfile}" Content="Pk" help:CommandHelp.Key="toolpath.pocket"/><Button Classes="paletteCommand" Click="CreateDrill_Click" IsEnabled="{Binding HasSelection}" Content="D" help:CommandHelp.Key="toolpath.drill"/><Button Classes="paletteCommand" Click="CreateEngrave_Click" IsEnabled="{Binding HasSelection}" Content="E" help:CommandHelp.Key="toolpath.engrave"/><Button Classes="paletteCommand" Click="CreateVCarve_Click" IsEnabled="{Binding CanCreateVCarve}" Content="V" ToolTip.Tip="{Binding VCarveGuidance}" help:CommandHelp.Key="toolpath.vcarve"/></UniformGrid><ListBox Grid.Row="2" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" Background="#141A1E" BorderBrush="#35414A" MinHeight="140"><ListBox.ItemTemplate><DataTemplate x:DataType="cam:CamOperationDefinition"><Border Padding="7" Margin="1,2" CornerRadius="4" Background="#242D33"><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#65C9FF" FontSize="9"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DetailSummary}" Foreground="#91A1AD" FontSize="9" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="3" ColumnDefinitions="*,*,*,Auto,Auto,Auto" ColumnSpacing="3" Margin="0,5,0,0"><Button Content="Edit" Click="EditProfile_Click" IsEnabled="{Binding SelectedOperation}"/><Button Grid.Column="1" Content="Copy" Click="DuplicateProfile_Click" IsEnabled="{Binding SelectedOperation}"/><Button Grid.Column="2" Content="Delete" Click="DeleteProfile_Click" IsEnabled="{Binding SelectedOperation}"/><Button Grid.Column="3" Classes="iconCommand" Content="↑" Click="MoveProfileUp_Click" IsEnabled="{Binding SelectedOperation}"/><Button Grid.Column="4" Classes="iconCommand" Content="↓" Click="MoveProfileDown_Click" IsEnabled="{Binding SelectedOperation}"/><Button Grid.Column="5" Classes="iconCommand" Content="⋯" Click="ViewportOverflow_Click" IsEnabled="{Binding SelectedOperation}" ToolTip.Tip="More operation actions"><Button.ContextMenu><ContextMenu><MenuItem Header="Enable / Disable" Click="ToggleProfile_Click"/><MenuItem Header="Recalculate" Click="RecalculateProfile_Click"/><MenuItem Header="Remove Last Tab" Click="DeleteTab_Click"/></ContextMenu></Button.ContextMenu></Button></Grid><Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,5,0,0"><TextBlock Text="{Binding PreflightStatus}" Foreground="#65C9FF" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PreflightSummary}"/><ToggleButton x:Name="TabEditToggle" Grid.Column="1" Classes="iconCommand" Content="T" Click="TabEdit_Click" IsEnabled="{Binding SelectedOperation}" ToolTip.Tip="Place tabs"/><Button Grid.Column="2" Classes="iconCommand" Content="✓" Click="RunPreflight_Click" IsEnabled="{Binding HasOperations}" help:CommandHelp.Key="toolpath.preflight"/></Grid></Grid>

          <ScrollViewer IsVisible="{Binding IsOperationEditorOpen}"><StackPanel Margin="8" Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="sectionHeading" Text="GUIDED TOOLPATH EDITOR" VerticalAlignment="Center"/><ToggleButton Grid.Column="1" Classes="compact" Content="Advanced" IsChecked="{Binding IsAdvancedMode}" ToolTip.Tip="Show or hide strategy, entry, allowance, and ordering controls"/></Grid><Border Classes="guidance" IsVisible="{Binding !IsAdvancedMode}"><TextBlock Text="Guided mode shows safe essentials. Turn on Advanced for strategy, entry, allowances and ordering." TextWrapping="Wrap"/></Border><TextBlock Classes="sectionHeading" Text="1 · VECTOR SELECTION"/><Button Content="Use Current Selection" Click="SelectEditorVectors_Click"/><ContentControl Content="{Binding OperationEditorDraft}"><ContentControl.DataTemplates>
            <DataTemplate DataType="cam:ProfileOperationDefinition" x:DataType="cam:ProfileOperationDefinition"><StackPanel Spacing="5"><TextBlock Classes="sectionHeading" Text="2 · DEPTHS"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding StartDepthMm}" PlaceholderText="Start"/><NumericUpDown Grid.Column="1" Value="{Binding CutDepthMm}" PlaceholderText="Final"/><NumericUpDown Grid.Column="2" Value="{Binding PassDepthMm}" PlaceholderText="Pass"/></Grid><TextBlock Classes="sectionHeading" Text="4 · CUTTING OPTIONS"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><ComboBox ItemsSource="{Binding $parent[Window].DataContext.ProfileSides}" SelectedItem="{Binding Side}" PlaceholderText="Side"/><ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].DataContext.CutDirections}" SelectedItem="{Binding Direction}" PlaceholderText="Direction"/></Grid><StackPanel Spacing="4" IsVisible="{Binding $parent[Window].DataContext.IsAdvancedMode}"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding AllowanceMm}" PlaceholderText="Allowance"/><NumericUpDown Grid.Column="1" Value="{Binding StartPointFraction}" PlaceholderText="Start 0–1"/><NumericUpDown Grid.Column="2" Value="{Binding LastPassDepthMm}" PlaceholderText="Last pass"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding OnionSkinMm}" PlaceholderText="Onion skin"/><NumericUpDown Grid.Column="1" Value="{Binding FinishAllowanceMm}" PlaceholderText="Finish allowance"/></Grid><CheckBox Content="Add finish pass" IsChecked="{Binding FinishPassEnabled}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><ComboBox ItemsSource="{Binding $parent[Window].DataContext.ProfileLeadStyles}" SelectedItem="{Binding LeadStyle}"/><ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].DataContext.ProfileEntryModes}" SelectedItem="{Binding EntryMode}"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding LeadInLengthMm}" PlaceholderText="Lead in"/><NumericUpDown Grid.Column="1" Value="{Binding LeadOutLengthMm}" PlaceholderText="Lead out"/><NumericUpDown Grid.Column="2" Value="{Binding RampLengthMm}" PlaceholderText="Ramp"/></Grid></StackPanel><TextBlock Classes="sectionHeading" Text="5 · TABS"/><CheckBox Content="Use tabs" IsChecked="{Binding Tabs.Enabled}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><ComboBox ItemsSource="{Binding $parent[Window].DataContext.TabPlacementModes}" SelectedItem="{Binding Tabs.PlacementMode}"/><NumericUpDown Grid.Column="1" Value="{Binding Tabs.AutomaticCount}" PlaceholderText="Tab count"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding Tabs.WidthMm}" PlaceholderText="Width"/><NumericUpDown Grid.Column="1" Value="{Binding Tabs.RemainingHeightMm}" PlaceholderText="Remain"/><ComboBox Grid.Column="2" ItemsSource="{Binding $parent[Window].DataContext.TabStyles}" SelectedItem="{Binding Tabs.Style}"/></Grid><TextBlock Classes="sectionHeading" Text="6 · MACHINE VALUES"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SafeZMm}" PlaceholderText="Safe Z"/><NumericUpDown Grid.Column="1" Value="{Binding SpindleRpm}" PlaceholderText="RPM"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding FeedRateMmPerMin}" PlaceholderText="Feed"/><NumericUpDown Grid.Column="1" Value="{Binding PlungeRateMmPerMin}" PlaceholderText="Plunge"/></Grid></StackPanel></DataTemplate>
            <DataTemplate DataType="cam:PocketOperationDefinition" x:DataType="cam:PocketOperationDefinition"><StackPanel Spacing="5"><TextBlock Classes="sectionHeading" Text="2 · DEPTHS"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding StartDepthMm}" PlaceholderText="Start"/><NumericUpDown Grid.Column="1" Value="{Binding CutDepthMm}" PlaceholderText="Final"/><NumericUpDown Grid.Column="2" Value="{Binding PassDepthMm}" PlaceholderText="Pass"/></Grid><TextBlock Classes="sectionHeading" Text="4 · CUTTING OPTIONS"/><NumericUpDown Value="{Binding StepOverMm}" PlaceholderText="Stepover"/><StackPanel Spacing="4" IsVisible="{Binding $parent[Window].DataContext.IsAdvancedMode}"><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding AllowanceMm}" PlaceholderText="Finish allowance"/><NumericUpDown Grid.Column="1" Value="{Binding RoughAllowanceMm}" PlaceholderText="Rough allowance"/></Grid><CheckBox Content="Add finish pass" IsChecked="{Binding FinishPassEnabled}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><ComboBox ItemsSource="{Binding $parent[Window].DataContext.PocketStrategies}" SelectedItem="{Binding Strategy}"/><ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].DataContext.CutDirections}" SelectedItem="{Binding Direction}"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><ComboBox ItemsSource="{Binding $parent[Window].DataContext.PocketEntryModes}" SelectedItem="{Binding EntryMode}"/><NumericUpDown Grid.Column="1" Value="{Binding RampLengthMm}" PlaceholderText="Ramp / helix size"/></Grid></StackPanel><TextBlock Classes="sectionHeading" Text="6 · MACHINE VALUES"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SafeZMm}" PlaceholderText="Safe Z"/><NumericUpDown Grid.Column="1" Value="{Binding SpindleRpm}" PlaceholderText="RPM"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding FeedRateMmPerMin}" PlaceholderText="Feed"/><NumericUpDown Grid.Column="1" Value="{Binding PlungeRateMmPerMin}" PlaceholderText="Plunge"/></Grid></StackPanel></DataTemplate>
            <DataTemplate DataType="cam:DrillOperationDefinition" x:DataType="cam:DrillOperationDefinition"><StackPanel Spacing="5"><TextBlock Classes="sectionHeading" Text="2 · DEPTHS"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding CutDepthMm}" PlaceholderText="Tip depth" ToolTip.Tip="Distance from job Z zero to the drill tip at full depth"/><NumericUpDown Grid.Column="1" Value="{Binding PeckDepthMm}" PlaceholderText="Peck"/><NumericUpDown Grid.Column="2" Value="{Binding DwellSeconds}" PlaceholderText="Dwell"/></Grid><TextBlock Classes="sectionHeading" Text="4 · CYCLE &amp; ORDER"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><ComboBox ItemsSource="{Binding $parent[Window].DataContext.DrillCycles}" SelectedItem="{Binding Cycle}"/><ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].DataContext.DrillOrderings}" SelectedItem="{Binding Ordering}"/></Grid><TextBlock Classes="sectionHeading" Text="6 · MACHINE VALUES"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SafeZMm}" PlaceholderText="Safe Z"/><NumericUpDown Grid.Column="1" Value="{Binding RetractZMm}" PlaceholderText="Retract"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding PlungeRateMmPerMin}" PlaceholderText="Plunge"/><NumericUpDown Grid.Column="1" Value="{Binding SpindleRpm}" PlaceholderText="RPM"/></Grid></StackPanel></DataTemplate>
            <DataTemplate DataType="cam:EngraveOperationDefinition" x:DataType="cam:EngraveOperationDefinition"><StackPanel Spacing="5"><TextBlock Classes="sectionHeading" Text="2 · DEPTHS"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding StartDepthMm}" PlaceholderText="Start"/><NumericUpDown Grid.Column="1" Value="{Binding CutDepthMm}" PlaceholderText="Final"/><NumericUpDown Grid.Column="2" Value="{Binding PassDepthMm}" PlaceholderText="Pass"/></Grid><TextBlock Classes="sectionHeading" Text="4 · CUTTING OPTIONS"/><ComboBox ItemsSource="{Binding $parent[Window].DataContext.EngraveDirections}" SelectedItem="{Binding Direction}"/><TextBlock Classes="sectionHeading" Text="6 · MACHINE VALUES"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SafeZMm}" PlaceholderText="Safe Z"/><NumericUpDown Grid.Column="1" Value="{Binding SpindleRpm}" PlaceholderText="RPM"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding FeedRateMmPerMin}" PlaceholderText="Feed"/><NumericUpDown Grid.Column="1" Value="{Binding PlungeRateMmPerMin}" PlaceholderText="Plunge"/></Grid></StackPanel></DataTemplate>
            <DataTemplate DataType="cam:VCarveOperationDefinition" x:DataType="cam:VCarveOperationDefinition"><StackPanel Spacing="5"><TextBlock Classes="sectionHeading" Text="2 · DEPTHS"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding MaximumDepthMm}" PlaceholderText="Max depth"/><NumericUpDown Grid.Column="1" Value="{Binding OffsetStepOverMm}" PlaceholderText="Stepover"/></Grid><CheckBox Content="Clear flat regions" IsChecked="{Binding ClearFlatRegions}"/><TextBlock Classes="sectionHeading" Text="6 · MACHINE VALUES"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SafeZMm}" PlaceholderText="Safe Z"/><NumericUpDown Grid.Column="1" Value="{Binding SpindleRpm}" PlaceholderText="RPM"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding FeedRateMmPerMin}" PlaceholderText="Feed"/><NumericUpDown Grid.Column="1" Value="{Binding PlungeRateMmPerMin}" PlaceholderText="Plunge"/></Grid></StackPanel></DataTemplate>
            <DataTemplate DataType="cam:SurfaceOperationDefinition" x:DataType="cam:SurfaceOperationDefinition"><StackPanel Spacing="5"><TextBlock Classes="sectionHeading" Text="2 · STOCK AREA"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding WidthMm}" PlaceholderText="Width"/><NumericUpDown Grid.Column="1" Value="{Binding HeightMm}" PlaceholderText="Height"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding CutDepthMm}" PlaceholderText="Depth"/><NumericUpDown Grid.Column="1" Value="{Binding PassDepthMm}" PlaceholderText="Pass"/><NumericUpDown Grid.Column="2" Value="{Binding StepOverMm}" PlaceholderText="Stepover"/></Grid><StackPanel Spacing="4" IsVisible="{Binding $parent[Window].DataContext.IsAdvancedMode}"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding OriginXmm}" PlaceholderText="Origin X"/><NumericUpDown Grid.Column="1" Value="{Binding OriginYmm}" PlaceholderText="Origin Y"/><NumericUpDown Grid.Column="2" Value="{Binding OvertravelMm}" PlaceholderText="Overtravel"/></Grid></StackPanel><ComboBox ItemsSource="{Binding $parent[Window].DataContext.SurfaceStrategies}" SelectedItem="{Binding Strategy}"/><TextBlock Classes="sectionHeading" Text="6 · MACHINE VALUES"/><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SafeZMm}" PlaceholderText="Safe Z"/><NumericUpDown Grid.Column="1" Value="{Binding SpindleRpm}" PlaceholderText="RPM"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding FeedRateMmPerMin}" PlaceholderText="Feed"/><NumericUpDown Grid.Column="1" Value="{Binding PlungeRateMmPerMin}" PlaceholderText="Plunge"/></Grid></StackPanel></DataTemplate>
          </ContentControl.DataTemplates></ContentControl><TextBlock Classes="sectionHeading" Text="3 · TOOL SNAPSHOT"/><ComboBox ItemsSource="{Binding FilteredTools}" SelectedItem="{Binding SelectedTool}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose library tool"/><TextBlock Text="{Binding OperationEditorDraft.ToolSummary}" Foreground="#91A1AD" TextWrapping="Wrap"/><Button Content="Apply Selected Tool Snapshot" Click="UseEditorTool_Click"/><TextBlock Classes="sectionHeading" Text="7 · OPERATION NAME"/><TextBox Text="{Binding OperationEditorDraft.Name}" PlaceholderText="Operation name"/></StackPanel></ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsToolLibraryTask}">
            <StackPanel Margin="8" Spacing="6">
              <TextBlock Classes="sectionHeading" Text="MATERIAL LIBRARY"/>
              <TextBox Text="{Binding MaterialSearch}" PlaceholderText="Search materials…"/>
              <ComboBox ItemsSource="{Binding FilteredMaterials}" SelectedItem="{Binding SelectedMaterial}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Material"/>
              <StackPanel IsVisible="{Binding SelectedMaterial}" Spacing="4"><TextBox Text="{Binding SelectedMaterial.Name}" PlaceholderText="Material name"/><TextBox Text="{Binding SelectedMaterial.Category}" PlaceholderText="Category"/><TextBox Text="{Binding SelectedMaterial.Notes}" PlaceholderText="Notes" AcceptsReturn="True"/></StackPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button Content="New" Click="AddMaterial_Click"/><Button Grid.Column="1" Classes="primary" Content="Save" Click="SaveMaterial_Click"/><Button Grid.Column="2" Content="Delete" Click="DeleteMaterial_Click"/></Grid>
              <TextBlock Classes="sectionHeading" Text="TOOL LIBRARY"/>
              <Grid ColumnDefinitions="*,110" ColumnSpacing="5"><TextBox Text="{Binding ToolSearch}" PlaceholderText="Search tools…"/><ComboBox Grid.Column="1" ItemsSource="{Binding ToolCategories}" SelectedItem="{Binding SelectedToolCategory}"/></Grid>
              <ComboBox ItemsSource="{Binding FilteredTools}" SelectedItem="{Binding SelectedTool}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Select tool"/>
              <StackPanel IsVisible="{Binding SelectedTool}" Spacing="5">
                <TextBox Text="{Binding SelectedTool.Name}" PlaceholderText="Tool name"/><ComboBox ItemsSource="{Binding ToolTypes}" SelectedItem="{Binding SelectedTool.Type}" PlaceholderText="Tool type"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedTool.ToolNumber}" PlaceholderText="T #"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedTool.DiameterMm}" PlaceholderText="Ø mm"/><NumericUpDown Grid.Column="2" Value="{Binding SelectedTool.FluteCount}" PlaceholderText="Flutes"/></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedTool.CuttingLengthMm}" PlaceholderText="Cut length"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedTool.OverallLengthMm}" PlaceholderText="Overall length"/></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedTool.ShankDiameterMm}" PlaceholderText="Shank Ø"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedTool.StickOutMm}" PlaceholderText="Stick-out"/></Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedTool.FeedRateMmPerMin}" PlaceholderText="Feed"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedTool.PlungeRateMmPerMin}" PlaceholderText="Plunge"/><NumericUpDown Grid.Column="2" Value="{Binding SelectedTool.SpindleRpm}" PlaceholderText="RPM"/></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedTool.StepDownMm}" PlaceholderText="Pass depth"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedTool.StepOverPercent}" PlaceholderText="Stepover %"/></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedTool.VBitAngleDegrees}" PlaceholderText="V angle"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedTool.TipDiameterMm}" PlaceholderText="Tip Ø"/></Grid>
                <TextBox Text="{Binding SelectedTool.Manufacturer}" PlaceholderText="Manufacturer"/><TextBox Text="{Binding SelectedTool.ManufacturerPartNumber}" PlaceholderText="Part number"/><TextBox Text="{Binding SelectedTool.Supplier}" PlaceholderText="Supplier"/><TextBox Text="{Binding SelectedTool.ProductUrl}" PlaceholderText="Product URL"/><TextBox Text="{Binding SelectedTool.Notes}" PlaceholderText="Notes" AcceptsReturn="True"/><TextBox Text="{Binding SelectedTool.ImageRelativePath}" PlaceholderText="Image relative path"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button Content="New" Click="AddTool_Click"/><Button Grid.Column="1" Classes="primary" Content="Save" Click="SaveTool_Click"/><Button Grid.Column="2" Content="Delete" Click="DeleteTool_Click"/></Grid>
              <TextBlock Classes="sectionHeading" Text="CUTTING PRESETS"/>
              <TextBox Text="{Binding PresetSearch}" PlaceholderText="Search presets…"/>
              <ComboBox ItemsSource="{Binding FilteredToolPresets}" SelectedItem="{Binding SelectedToolPreset}" PlaceholderText="Preset"><ComboBox.ItemTemplate><DataTemplate x:DataType="tools:ToolCuttingPreset"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding FeedRateMmPerMin, StringFormat='{}{0:0} mm/min'}"/><TextBlock Text="{Binding SpindleRpm, StringFormat='{}{0} RPM'}" Foreground="#91A1AD"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="Preset references the selected tool, machine and material. New operations receive an immutable snapshot." Foreground="#91A1AD" TextWrapping="Wrap"/>
              <StackPanel IsVisible="{Binding SelectedToolPreset}" Spacing="4"><Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedToolPreset.FeedRateMmPerMin}" PlaceholderText="Feed"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedToolPreset.PlungeRateMmPerMin}" PlaceholderText="Plunge"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedToolPreset.SpindleRpm}" PlaceholderText="RPM"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedToolPreset.PassDepthMm}" PlaceholderText="Pass"/><NumericUpDown Grid.Column="2" Value="{Binding SelectedToolPreset.StepOverPercent}" PlaceholderText="Stepover %"/></Grid></StackPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button Content="New" Click="AddPreset_Click"/><Button Grid.Column="1" Classes="primary" Content="Save" Click="SavePreset_Click"/><Button Grid.Column="2" Content="Delete" Click="DeletePreset_Click"/></Grid>
              <TextBlock Classes="sectionHeading" Text="IMPORT / EXPORT"/>
              <ComboBox ItemsSource="{Binding LibraryExchangeFormats}" SelectedItem="{Binding SelectedLibraryExchangeFormat}"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><Button Content="Import…" Click="ImportLibrary_Click"/><Button Grid.Column="1" Content="Export…" Click="ExportLibrary_Click"/></Grid>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsMachineFixturesTask}">
            <StackPanel Margin="8" Spacing="6">
              <TextBox Text="{Binding MachineSearch}" PlaceholderText="Search machines…"/>
              <ComboBox ItemsSource="{Binding FilteredMachines}" SelectedItem="{Binding SelectedMachine}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Machine"/>
              <TextBox Text="{Binding SelectedMachine.Name}" PlaceholderText="Machine name"/>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                <Button Content="New" Click="AddMachine_Click"/>
                <Button Grid.Column="1" Content="Use" Click="UseMachine_Click"/>
                <Button Grid.Column="2" Classes="primary" Content="Save" Click="SaveMachine_Click"/>
                <Button Grid.Column="3" Content="Delete" Click="DeleteMachine_Click" IsEnabled="{Binding SelectedMachine}"/>
              </Grid>
              <TextBlock Classes="sectionHeading" Text="TRAVEL &amp; TIMING"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedMachine.MinimumXmm}" PlaceholderText="Min X"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.MaximumXmm}" PlaceholderText="Max X"/></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedMachine.MinimumYmm}" PlaceholderText="Min Y"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.MaximumYmm}" PlaceholderText="Max Y"/></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedMachine.MinimumZmm}" PlaceholderText="Min Z"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.MaximumZmm}" PlaceholderText="Max Z"/></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedMachine.RapidRateMmPerMin}" PlaceholderText="Rapid mm/min"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.ToolChangeSeconds}" PlaceholderText="Tool change sec"/></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedMachine.MaximumSpindleRpm}" PlaceholderText="Max RPM"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.DefaultClearanceMm}" PlaceholderText="Clearance"/></Grid>
              <TextBlock Classes="sectionHeading" Text="TOOL ASSEMBLY"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedMachine.HolderDiameterMm}" PlaceholderText="Holder Ø"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.HolderLengthMm}" PlaceholderText="Holder length"/></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedMachine.ToolChangeXmm}" PlaceholderText="Tool change X"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.ToolChangeYmm}" PlaceholderText="Tool change Y"/></Grid>
              <NumericUpDown Value="{Binding SelectedMachine.AllowedSpoilboardDepthMm}" PlaceholderText="Allowed spoilboard cut"/>
              <TextBlock Classes="sectionHeading" Text="CONTROLLER OUTPUT"/>
              <ComboBox ItemsSource="{Binding PostProcessorIds}" SelectedItem="{Binding SelectedMachine.PostProcessorId}" PlaceholderText="Postprocessor"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5"><ComboBox ItemsSource="{Binding ControllerFamilies}" SelectedItem="{Binding SelectedMachine.ControllerFamily}" PlaceholderText="Controller"/><ComboBox Grid.Column="1" ItemsSource="{Binding MeasurementUnits}" SelectedItem="{Binding SelectedMachine.OutputUnit}" PlaceholderText="Output unit"/></Grid>
              <ComboBox ItemsSource="{Binding MachineToolChangeModes}" SelectedItem="{Binding SelectedMachine.ToolChangeMode}" PlaceholderText="Tool change"/>
              <CheckBox Content="Controller supports XY arcs" IsChecked="{Binding SelectedMachine.SupportsArcs}"/>
              <CheckBox Content="Emit configured machine-coordinate park move" IsChecked="{Binding SelectedMachine.ParkEnabled}"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5"><NumericUpDown Value="{Binding SelectedMachine.ParkXmm}" PlaceholderText="Park X"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedMachine.ParkYmm}" PlaceholderText="Park Y"/></Grid>
              <TextBlock Classes="sectionHeading" Text="FIXTURES"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Add Clamp" Click="AddFixture_Click"/><Button Grid.Column="1" Content="Delete Clamp" Click="DeleteFixture_Click" IsEnabled="{Binding SelectedFixture}"/></Grid>
              <ListBox ItemsSource="{Binding Fixtures}" SelectedItem="{Binding SelectedFixture}" MinHeight="90"><ListBox.ItemTemplate><DataTemplate x:DataType="safety:FixtureDefinition"><TextBlock Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
              <StackPanel IsVisible="{Binding SelectedFixture}" Spacing="4">
                <TextBox Text="{Binding SelectedFixture.Name}" LostFocus="FixtureField_LostFocus"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedFixture.MinXmm}" PlaceholderText="Min X" LostFocus="FixtureField_LostFocus"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedFixture.MaxXmm}" PlaceholderText="Max X" LostFocus="FixtureField_LostFocus"/></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedFixture.MinYmm}" PlaceholderText="Min Y" LostFocus="FixtureField_LostFocus"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedFixture.MaxYmm}" PlaceholderText="Max Y" LostFocus="FixtureField_LostFocus"/></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><NumericUpDown Value="{Binding SelectedFixture.TopZmm}" PlaceholderText="Top Z" LostFocus="FixtureField_LostFocus"/><NumericUpDown Grid.Column="1" Value="{Binding SelectedFixture.RequiredClearanceMm}" PlaceholderText="Required clearance" LostFocus="FixtureField_LostFocus"/></Grid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid></views:TaskPanelHost.Body>
        <views:TaskPanelHost.Footer><Grid><Grid IsVisible="{Binding IsToolpathPalette}" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="5" RowSpacing="5"><Button Content="Preview Selected" Click="PreviewSelected_Click" IsEnabled="{Binding SelectedOperation}" help:CommandHelp.Key="toolpath.preview"/><Button Grid.Column="1" Classes="primary" Content="Preview All" Click="PreviewGCode_Click" IsEnabled="{Binding HasOperations}" help:CommandHelp.Key="toolpath.preview"/><Button Grid.Row="1" Grid.ColumnSpan="2" Classes="primary" Content="Save Toolpaths…" Click="SaveToolpaths_Click" IsEnabled="{Binding CanSaveToolpaths}" ToolTip.Tip="{Binding ExportAvailabilityMessage}" help:CommandHelp.Key="toolpath.export"/></Grid><Grid IsVisible="{Binding IsOperationEditorOpen}" ColumnDefinitions="*,*" ColumnSpacing="5"><Button Content="Cancel / Close" Click="CancelOperationEditor_Click"/><Button Grid.Column="1" Classes="primary" Content="Calculate / Apply" Click="ApplyOperationEditor_Click"/></Grid><Button IsVisible="{Binding IsToolLibraryTask}" Classes="primary" Content="Done" Click="CloseToolpathTask_Click" HorizontalAlignment="Stretch"/><Button IsVisible="{Binding IsMachineFixturesTask}" Classes="primary" Content="Done" Click="CloseToolpathTask_Click" HorizontalAlignment="Stretch"/></Grid></views:TaskPanelHost.Footer>
      </views:TaskPanelHost>
    </Grid>

    <Border Grid.Row="3" Background="#20282E" BorderBrush="#34414A" BorderThickness="0,1,0,0" Padding="8,3"><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14"><TextBlock Text="{Binding Message}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}"/><TextBlock Grid.Column="1" Text="{Binding InteractionStatus}" Foreground="#65C9FF" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding PointerStatus}" FontSize="10"/><TextBlock Grid.Column="3" Text="{Binding ZoomStatus}" FontSize="10"/></Grid></Border>

    <Border Grid.RowSpan="4" IsVisible="{Binding !HasJob}" Background="#E612171B" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Width="720" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" CornerRadius="12" Background="#161D21" BorderBrush="#40515C" BorderThickness="1"><Grid RowDefinitions="Auto,*" ColumnDefinitions="320,1,320" ColumnSpacing="22"><StackPanel Spacing="8"><Image x:Name="StartupLogo" Source="avares://V-Router/Assets/v-router-logo.png" Width="112" Height="112" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="V-Router logo"/><TextBlock Text="Start a CNC job" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Set up material, draw or import vectors, calculate toolpaths, preview stock removal, then export validated controller-ready G-code." TextWrapping="Wrap" Foreground="#AEBCC5"/></StackPanel><Border Grid.RowSpan="2" Grid.Column="1" Width="1" Background="#34414A"/><StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="OPEN EXISTING" Classes="sectionHeading"/><TextBlock Text="Continue a recent project or restore a recovery snapshot." TextWrapping="Wrap" Foreground="#AEBCC5"/></StackPanel><StackPanel Grid.Row="1" Spacing="8" Margin="0,18,0,0"><Button Classes="primary taskButton" Content="New Job" Click="NewJob_Click"/><Button Classes="taskButton" Content="Open Project…" Click="Open_Click"/></StackPanel><ScrollViewer Grid.Row="1" Grid.Column="2" Margin="0,18,0,0" MaxHeight="370"><StackPanel Spacing="6"><TextBlock Text="RECOVERED JOBS" Classes="sectionHeading"/><ItemsControl ItemsSource="{Binding RecoverableProjects}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,70" ColumnSpacing="5" Margin="0,2"><Button Content="{Binding DisplayName}" Tag="{Binding}" Click="RecoveryProjectButton_Click" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding DisplayName}"/><Button Grid.Column="1" Content="Discard" Tag="{Binding}" Click="DiscardRecovery_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="RECENT PROJECTS" Classes="sectionHeading"/><ItemsControl ItemsSource="{Binding RecentProjects}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Path}" Click="RecentProjectButton_Click" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding Name}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid></Border>
    </Border>
  </Grid>
</Window>
