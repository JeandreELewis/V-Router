<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:CncCad.App.ViewModels" x:Class="CncCad.App.Views.ProfileOperationWindow" x:DataType="vm:ProfileOperationEditorViewModel" Width="650" Height="720" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#181E23" Title="Profile Toolpath">
  <Grid RowDefinitions="Auto,*,Auto"><Border Background="#20282E" Padding="24,18" BorderBrush="#35414A" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="Profile Toolpath" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Create a cutter-compensated profile from the selected closed vectors." Foreground="#9AA9B4"/></StackPanel></Border>
    <ScrollViewer Grid.Row="1"><StackPanel Margin="24,18" Spacing="9"><TextBlock Text="Operation name"/><TextBox Text="{Binding Draft.Name}"/>
      <TextBlock Classes="heading" Text="TOOL" Margin="0,12,0,2"/><ComboBox x:Name="ToolPicker" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedLibraryTool}" SelectionChanged="ToolPicker_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Border Background="#26333B" Padding="10" CornerRadius="5"><Grid ColumnDefinitions="*,*,*"><TextBlock Text="{Binding Draft.Tool.Name}"/><TextBlock Grid.Column="1" Text="{Binding Draft.Tool.DiameterMm, StringFormat='{}{0:0.###} mm'}"/><TextBlock Grid.Column="2" Text="{Binding Draft.Tool.ToolNumber, StringFormat='Tool {0}'}"/></Grid></Border>
      <TextBlock Classes="heading" Text="CUT" Margin="0,12,0,2"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Cut side"/><ComboBox ItemsSource="{Binding Sides}" SelectedItem="{Binding Draft.Side}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Direction"/><ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Draft.Direction}"/></StackPanel></Grid>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Start depth (mm)"/><NumericUpDown Value="{Binding Draft.StartDepthMm}" Minimum="0" Maximum="1000" ValueChanged="Depth_ValueChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Final depth (mm)"/><NumericUpDown Value="{Binding Draft.CutDepthMm}" Minimum="0.001" Maximum="1000" ValueChanged="Depth_ValueChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Pass depth (mm)"/><NumericUpDown Value="{Binding Draft.PassDepthMm}" Minimum="0.001" Maximum="1000" ValueChanged="Depth_ValueChanged"/></StackPanel></Grid>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Allowance (mm)"/><NumericUpDown Value="{Binding Draft.AllowanceMm}" Minimum="0" Maximum="100"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Start point (0–1)"/><NumericUpDown Value="{Binding Draft.StartPointFraction}" Minimum="0" Maximum="0.999" Increment="0.05"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Separate last pass"/><NumericUpDown Value="{Binding Draft.LastPassDepthMm}" Minimum="0.001" Maximum="1000"/></StackPanel></Grid>
      <TextBlock Classes="heading" Text="ENTRY &amp; EXIT" Margin="0,12,0,2"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Lead in (mm)"/><NumericUpDown Value="{Binding Draft.LeadInLengthMm}" Minimum="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Lead out (mm)"/><NumericUpDown Value="{Binding Draft.LeadOutLengthMm}" Minimum="0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ramp length (mm)"/><NumericUpDown Value="{Binding Draft.RampLengthMm}" Minimum="0"/></StackPanel></Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Feed (mm/min)"/><NumericUpDown Value="{Binding Draft.FeedRateMmPerMin}" Minimum="1" Maximum="100000"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Plunge (mm/min)"/><NumericUpDown Value="{Binding Draft.PlungeRateMmPerMin}" Minimum="1" Maximum="100000"/></StackPanel></Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Spindle RPM"/><NumericUpDown Value="{Binding Draft.SpindleRpm}" Minimum="0" Maximum="100000"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Safe Z (mm)"/><NumericUpDown Value="{Binding Draft.SafeZMm}" Minimum="0.001" Maximum="1000"/></StackPanel></Grid>
      <TextBlock Classes="heading" Text="CUTOUT TABS" Margin="0,12,0,2"/><CheckBox Content="Keep parts attached with ramped tabs" IsChecked="{Binding Draft.Tabs.Enabled}"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Placement"/><ComboBox ItemsSource="{Binding TabPlacementModes}" SelectedItem="{Binding Draft.Tabs.PlacementMode}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Automatic count"/><NumericUpDown Value="{Binding Draft.Tabs.AutomaticCount}" Minimum="1" Maximum="100"/></StackPanel></Grid>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Width (mm)"/><NumericUpDown Value="{Binding Draft.Tabs.WidthMm}" Minimum="0.1"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Height left (mm)"/><NumericUpDown Value="{Binding Draft.Tabs.RemainingHeightMm}" Minimum="0.1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ramp (mm)"/><NumericUpDown Value="{Binding Draft.Tabs.RampLengthMm}" Minimum="0"/></StackPanel></Grid>
      <TextBlock Text="Manual tab positions are stored on the operation and can be adjusted on the design canvas after saving." Foreground="#91A1AD" FontSize="10" TextWrapping="Wrap"/>
      <Border Background="#26333B" Padding="10" CornerRadius="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Draft.GeometryIds.Count, StringFormat='{}{0} contours selected'}"/><TextBlock Grid.Column="1" Text="{Binding PassCount, StringFormat='{}{0} depth passes'}" Foreground="#65C9FF"/></Grid></Border>
      <TextBlock Text="{Binding WarningMessage}" Foreground="#E4B66A" TextWrapping="Wrap"/><TextBlock Text="{Binding ValidationMessage}" Foreground="#FF9C9C" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Background="#20282E" Padding="18,14" BorderBrush="#35414A" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save Toolpath" Click="Save_Click"/></StackPanel></Border>
  </Grid>
</Window>
