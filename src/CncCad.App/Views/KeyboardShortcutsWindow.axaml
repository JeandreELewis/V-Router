<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:CncCad.App.Views" x:Class="CncCad.App.Views.KeyboardShortcutsWindow" Width="650" Height="650" WindowStartupLocation="CenterOwner" Background="#181E23" Title="Keyboard Shortcuts">
  <Grid RowDefinitions="Auto,*,Auto"><Border Background="#20282E" Padding="22,16"><StackPanel><TextBlock Text="Keyboard Shortcuts" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Use Command on macOS and Control on Windows or Linux." Foreground="#9AA9B4"/></StackPanel></Border><ScrollViewer Grid.Row="1"><StackPanel Margin="22" Spacing="6"><TextBox x:Name="SearchBox" PlaceholderText="Search shortcuts" TextChanged="SearchChanged"/><ItemsControl x:Name="ShortcutList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="views:ShortcutEntry"><Grid ColumnDefinitions="150,*,Auto" Margin="2,5"><TextBlock Text="{Binding Group}" Foreground="#65C9FF"/><TextBlock Grid.Column="1" Text="{Binding Action}"/><Border Grid.Column="2" Background="#2A343B" CornerRadius="4" Padding="8,3"><TextBlock Text="{Binding Gesture}" FontFamily="monospace"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer><Border Grid.Row="2" Background="#20282E" Padding="14"><Button Content="Close" HorizontalAlignment="Right" Click="Close_Click"/></Border></Grid>
</Window>
