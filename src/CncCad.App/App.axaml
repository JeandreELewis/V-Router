<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CncCad.App.App"
             xmlns:local="using:CncCad.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <SolidColorBrush x:Key="CncAccentBrush" Color="#65C9FF"/>
        <ControlTheme x:Key="CompactSpinnerButton" TargetType="RepeatButton">
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#61717A"/>
            <Setter Property="Foreground" Value="#D7E5EC"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_ButtonBorder">
                <Setter Property="Background" Value="#34434C"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_ButtonBorder">
                <Setter Property="Background" Value="#17658A"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.35"/>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}"/>
            <Setter Property="MinWidth" Value="{DynamicResource TextControlThemeMinWidth}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <DockPanel>
                                <Grid Name="PART_SpinnerPanel"
                                      DockPanel.Dock="Right"
                                      Width="22"
                                      RowDefinitions="*,*"
                                      IsVisible="{TemplateBinding ShowButtonSpinner}">
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  Grid.Row="0"
                                                  Theme="{StaticResource CompactSpinnerButton}"
                                                  IsTabStop="False"
                                                  BorderThickness="1,0,0,0.5">
                                        <PathIcon Width="7" Height="4" Data="M0,4 L3.5,0 7,4"/>
                                    </RepeatButton>
                                    <RepeatButton Name="PART_DecreaseButton"
                                                  Grid.Row="1"
                                                  Theme="{StaticResource CompactSpinnerButton}"
                                                  IsTabStop="False"
                                                  BorderThickness="1,0.5,0,0">
                                        <PathIcon Width="7" Height="4" Data="M0,0 L3.5,4 7,0"/>
                                    </RepeatButton>
                                </Grid>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Padding="{TemplateBinding Padding}"/>
                            </DockPanel>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:error">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}"/>
            </Style>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.editTile"><Setter Property="Height" Value="58"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style Selector="TextBlock.heading"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#91A1AD"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style Selector="TextBlock.sectionHeading"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#8296A2"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="3,13,3,4"/></Style>
        <Style Selector="TextBlock.fieldLabel"><Setter Property="Foreground" Value="#9FB0BA"/><Setter Property="FontSize" Value="9"/><Setter Property="Margin" Value="1,0,1,2"/></Style>
        <Style Selector="Button.primary"><Setter Property="Background" Value="#17658A"/><Setter Property="BorderBrush" Value="{DynamicResource CncAccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style Selector="Button.compact"><Setter Property="Padding" Value="9,4"/><Setter Property="FontSize" Value="10"/><Setter Property="MinHeight" Value="26"/></Style>
        <Style Selector="ToggleButton.compact"><Setter Property="Padding" Value="9,4"/><Setter Property="FontSize" Value="10"/><Setter Property="MinHeight" Value="26"/></Style>
        <Style Selector="ToggleButton.viewTab"><Setter Property="Padding" Value="13,5"/><Setter Property="FontSize" Value="11"/><Setter Property="CornerRadius" Value="5"/></Style>
        <Style Selector="Button.actionTile"><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="FontSize" Value="11"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
        <Style Selector="ToggleButton.actionTile"><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="FontSize" Value="11"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
        <Style Selector="Border.panelCard"><Setter Property="Background" Value="#252E34"/><Setter Property="BorderBrush" Value="#39464F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10"/></Style>
        <Style Selector="Expander.toolSection"><Setter Property="Background" Value="#20292F"/><Setter Property="BorderBrush" Value="#36444D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
        <Style Selector="Expander.toolSection /template/ ToggleButton#PART_Header"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#D7E5EC"/><Setter Property="Padding" Value="2,5"/></Style>
        <Style Selector="Border.guidance"><Setter Property="Background" Value="#202A30"/><Setter Property="BorderBrush" Value="#33434D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="9"/></Style>
        <Style Selector="Border.comingTile"><Setter Property="Background" Value="#20272C"/><Setter Property="BorderBrush" Value="#354047"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="2"/><Setter Property="Opacity" Value="0.55"/></Style>
    </Application.Styles>
</Application>
