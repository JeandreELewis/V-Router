<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>V-Router</AssemblyName>
    <Product>V-Router</Product>
    <Title>V-Router</Title>
    <Company>Vision BI</Company>
    <Authors>Vision BI and V-Router contributors</Authors>
    <Copyright>Copyright © Vision BI and V-Router contributors</Copyright>
    <Description>Open-source CAD/CAM software for CNC router workflows.</Description>
    <ApplicationIcon>Assets/v-router.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <ProjectReference Include="..\CncCad.Core\CncCad.Core.csproj" />
    <ProjectReference Include="..\CncCad.Cam\CncCad.Cam.csproj" />
    <ProjectReference Include="..\CncCad.Rendering\CncCad.Rendering.csproj" />
    <ProjectReference Include="..\CncCad.PostProcessors\CncCad.PostProcessors.csproj" />
    <ProjectReference Include="..\CncCad.IO\CncCad.IO.csproj" />
    <ProjectReference Include="..\CncCad.Infrastructure\CncCad.Infrastructure.csproj" />
    <ProjectReference Include="..\CncCad.Simulation\CncCad.Simulation.csproj" />
  </ItemGroup>
</Project>
